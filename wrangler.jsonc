{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movie-review-by-poorna",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REACTIONS",
        "class_name": "ReactionStore"
      }
    ]
  },
  "exports": {
    "ReactionStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
