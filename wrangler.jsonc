{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movie-review-by-poorna",
  "main": "src/preview-worker-entry.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "R2_PUBLIC_BASE": "https://assets.moviereviewbypoorna.com"
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/data/catalog.json",
      "/data/content.json",
      "/data/index.json",
      "/data/cast-crew.json"
    ]
  },
  "r2_buckets": [
    {
      "binding": "REVIEW_ASSETS",
      "bucket_name": "movie-review-assets"
    }
  ]
}
