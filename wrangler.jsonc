{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movie-review-by-poorna",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-02",
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "movie-review-by-poorna-content",
      "database_id": "6c88b16c-c302-47cf-92cd-bdc5f8470bc2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REVIEW_ASSETS",
      "bucket_name": "movie-review-assets"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "2026091201",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LEGACY_REACTIONS",
        "class_name": "ReactionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-reactions",
      "new_sqlite_classes": [
        "ReactionStore"
      ]
    },
    {
      "tag": "v2-comments",
      "new_sqlite_classes": [
        "CommentsStore"
      ]
    },
    {
      "tag": "v3-admin-analytics",
      "new_sqlite_classes": [
        "AnalyticsStore"
      ]
    }
  ]
}
