---
import LoungeLoading from '../../components/lounge/LoungeLoading.astro';
import SiteFrame from '../../layouts/SiteFrame.astro';
import { getReviewBySlug } from '../../lib/data/reviews';
import '../../styles/auditorium.css';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const review = await getReviewBySlug(slug);

if (!review) {
  return Astro.redirect('/');
}

const dateFormatter = new Intl.DateTimeFormat('en-IN', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

function formatDate(value: string | null): string {
  if (!value) return '—';
  const date = new Date(`${value}T00:00:00Z`);
  return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
}

function starText(rating: number | null): string {
  const filled = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
  return `${'★'.repeat(filled)}${'☆'.repeat(5 - filled)}`;
}
---

<SiteFrame
  title={`${review.title} — The Auditorium | Movie Reviews By Poorna`}
  description={review.excerpt ?? `Read Poorna's review of ${review.title} in The Auditorium.`}
>
  <LoungeLoading theme="auditorium" />

  <main class="auditorium-reset-page" data-cinema-page>
    <div class="auditorium-reset-stage">
      <h1 class="visually-hidden">{review.title} — The Auditorium</h1>

      <p class="auditorium-reset-kicker">The Auditorium · Clean Runtime Baseline</p>
      <h2 class="auditorium-reset-title">{review.title}</h2>
      <p class="auditorium-reset-meta">
        {review.language ?? '—'} · {formatDate(review.releaseDate)} · {starText(review.rating)}
      </p>

      {
        review.posterUrl && (
          <img
            class="auditorium-reset-poster"
            src={review.posterUrl}
            alt={`${review.title} poster`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )
      }

      {
        review.verdict && (
          <p class="auditorium-reset-verdict">{review.verdict}</p>
        )
      }

      {
        review.credits.length > 0 && (
          <div class="auditorium-reset-credits" aria-label="Cast and crew">
            {review.credits.slice(0, 6).map((credit) => (
              <p class="auditorium-reset-credit"><strong>{credit.role}:</strong> {credit.name}</p>
            ))}
          </div>
        )
      }

      <article class="auditorium-reset-review" set:html={review.bodyHtml}></article>
    </div>
  </main>

  <script>
    import { prepareCinemaPage } from '../../lib/lounge-loading';
    const page = document.querySelector<HTMLElement>('[data-cinema-page]');
    if (page) prepareCinemaPage(page);
  </script>
</SiteFrame>
