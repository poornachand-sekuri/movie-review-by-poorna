---
import LobbyReviewCard from '../components/lobby/LobbyReviewCard.astro';
import SiteFrame from '../layouts/SiteFrame.astro';
import { listReviews } from '../lib/data/reviews';
import '../styles/lobby.css';

export const prerender = false;

const reviews = await listReviews({ limit: 13 });
const featured = reviews[0] ?? null;
const recent = reviews.slice(1, 5);
const archive = reviews.slice(5, 13);

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

function formatDate(value: string): string {
  const date = new Date(`${value}T00:00:00Z`);
  return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
}
---

<SiteFrame>
  <main class="lobby">
    <header class="lobby__header">
      <div class="shell lobby__header-inner">
        <p class="lobby__brand">Movie Review By Poorna</p>
        <p class="lobby__room-label">The Lobby</p>
      </div>
    </header>

    {
      featured ? (
        <section class="lobby__feature" aria-labelledby="latest-review-title">
          <div class="shell lobby__feature-grid">
            <div class="lobby__feature-poster">
              {featured.posterUrl ? (
                <img
                  src={featured.posterUrl}
                  alt={`${featured.title} poster`}
                  width="800"
                  height="1200"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              ) : (
                <div class="lobby__feature-poster-fallback" aria-hidden="true"></div>
              )}
            </div>

            <div class="lobby__feature-copy">
              <p class="lobby__eyebrow">Latest review</p>
              <h1 class="lobby__feature-title" id="latest-review-title">
                {featured.title}
              </h1>

              <p class="lobby__feature-meta">
                <span>{featured.language ?? 'Language not listed'}</span>
                <span aria-hidden="true">·</span>
                <span>{formatDate(featured.reviewedDate)}</span>
                {featured.rating !== null && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span class="lobby__feature-rating">{featured.rating}/5</span>
                  </>
                )}
              </p>

              {featured.verdict && <p class="lobby__feature-verdict">{featured.verdict}</p>}
              {featured.excerpt && <p class="lobby__feature-excerpt">{featured.excerpt}</p>}
            </div>
          </div>
        </section>
      ) : (
        <section class="shell lobby__feature">
          <h1>Movie Review By Poorna</h1>
          <p>No published reviews are available yet.</p>
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section class="lobby__section" aria-labelledby="recent-reviews-title">
          <div class="shell">
            <div class="lobby__section-heading">
              <div>
                <p class="lobby__section-kicker">On the board</p>
                <h2 id="recent-reviews-title">Recent reviews</h2>
              </div>
            </div>

            <div class="lobby__cards">
              {recent.map((review) => <LobbyReviewCard review={review} />)}
            </div>
          </div>
        </section>
      )
    }

    {
      archive.length > 0 && (
        <section class="lobby__section" aria-labelledby="archive-title">
          <div class="shell">
            <div class="lobby__section-heading">
              <div>
                <p class="lobby__section-kicker">From the reel shelf</p>
                <h2 id="archive-title">Previously reviewed</h2>
              </div>
            </div>

            <div class="lobby__archive">
              {archive.map((review) => (
                <article class="lobby__archive-item">
                  <h3>{review.title}</h3>
                  <p class="lobby__archive-meta">
                    {review.language ?? '—'} · {formatDate(review.reviewedDate)}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <footer class="lobby__footer">
      <div class="shell">
        <p>Movie Review By Poorna</p>
      </div>
    </footer>
  </main>
</SiteFrame>
