---
import SiteFrame from '../layouts/SiteFrame.astro';
import LoungeLoading from '../components/lounge/LoungeLoading.astro';
import { listReviews } from '../lib/data/reviews';
import '../styles/comments.css';
import '../styles/lounge.css';

export const prerender = false;

const reviews = await listReviews({ limit: 17, order: 'added' });
const featured = reviews[0] ?? null;
const recent = reviews.slice(1, 9);
const previous = reviews.slice(9, 17);

function toPages<T>(items: readonly T[], pageSize: number): T[][] {
  const pages: T[][] = [];
  for (let index = 0; index < items.length; index += pageSize) {
    pages.push(items.slice(index, index + pageSize));
  }
  return pages;
}

const recentPages = toPages(recent, 4);
const previousPages = toPages(previous, 4);

const shortMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function formatDate(value: string | null): string {
  if (!value) return '—';

  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
  if (!match) return value;

  const [, , monthValue, dayValue] = match;
  const month = shortMonths[Number(monthValue) - 1];
  const day = Number(dayValue);

  if (!month || !Number.isInteger(day) || day < 1 || day > 31) return value;
  return `${String(day).padStart(2, '0')} ${month}`;
}

function starText(rating: number | null): string {
  const filled = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
  return `${'★'.repeat(filled)}${'☆'.repeat(5 - filled)}`;
}

function reviewTarget(slug: string): string {
  return `/review/${encodeURIComponent(slug)}`;
}

const featuredPov = featured?.verdict?.trim() || '';
---

<SiteFrame
  title="Movie Reviews By Poorna"
  description="The Lounge at Movie Reviews By Poorna — latest reviews, recent reviews and cinema notes."
>
  <LoungeLoading />
  <main class="lounge-page">
    <div class="lounge-backdrop" aria-hidden="true"></div>
    <div class="lounge-shade" aria-hidden="true"></div>

    <div class="lounge-stage">
      <h1 class="visually-hidden">Movie Reviews By Poorna</h1>

      <section class="lounge-panel lounge-panel--banner" aria-label="Lounge navigation">
        <div class="lounge-banner-crop">
          <a class="lounge-nav-hit lounge-nav-hit--left" href="/" aria-label="Lounge home"></a>
          <a class="lounge-nav-hit lounge-nav-hit--right" href="/search" aria-label="Open Cini Cafe"></a>
        </div>
      </section>

      {
        featured ? (
          <section class="lounge-panel lounge-panel--now" aria-labelledby="now-reviewed-heading">
            <h2 id="now-reviewed-heading" class="visually-hidden">Now Reviewed</h2>
            <h2 class="now-title">{featured.title}</h2>

            <div class="now-poster" aria-label={`${featured.title} poster`}>
              {featured.posterUrl ? (
                <img
                  src={featured.posterUrl}
                  alt={`${featured.title} poster`}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              ) : (
                <span class="poster-fallback" aria-hidden="true"></span>
              )}
            </div>

            <div class="now-details">
              <dl class="now-meta">
                <div>
                  <dt>Released</dt>
                  <dd>{formatDate(featured.releaseDate)}</dd>
                </div>
                <div>
                  <dt>Language</dt>
                  <dd>{featured.language ?? '—'}</dd>
                </div>
                <div class="now-meta__rating">
                  <dt>Rating</dt>
                  <dd aria-label={`${Math.round(Number(featured.rating) || 0)} out of 5 stars`}>
                    {starText(featured.rating)}
                  </dd>
                </div>
              </dl>
            </div>

            <div class="now-pov" data-pov-fit tabindex="0" role="region" aria-label="My POV">
              <span class="now-pov__label"><span aria-hidden="true">◉</span> My POV</span>
              <p>{featuredPov || 'POV coming soon.'}</p>
            </div>

            <a class="now-read-hit" href={reviewTarget(featured.slug)} aria-label={`Read ${featured.title} review`}>
              <span class="visually-hidden">Read review</span>
            </a>
          </section>
        ) : (
          <section class="lounge-empty" aria-live="polite">No published reviews are available yet.</section>
        )
      }

      {
        recent.length > 0 && (
          <section class="lounge-panel lounge-panel--recent" aria-labelledby="recent-heading">
            <h2 id="recent-heading" class="visually-hidden">Recent Reviews</h2>

            <div class="recent-overlay review-carousel" data-review-carousel aria-label="Recent Reviews carousel">
              <div class="review-carousel__viewport">
                <div class="review-carousel__track" data-carousel-track>
                  {recentPages.map((page, pageIndex) => (
                    <div
                      class="review-carousel__page"
                      data-carousel-page
                      aria-hidden={pageIndex === 0 ? 'false' : 'true'}
                      inert={pageIndex === 0 ? undefined : true}
                    >
                      {page.map((review, index) => (
                        <a
                          class={`recent-card recent-card--${index + 1}`}
                          href={reviewTarget(review.slug)}
                          aria-label={`Read ${review.title} review`}
                        >
                          <span class="recent-card__poster">
                            {review.posterUrl ? (
                              <img
                                src={review.posterUrl}
                                alt=""
                                loading="lazy"
                                fetchpriority="low"
                                decoding="async"
                              />
                            ) : (
                              <span class="poster-fallback" aria-hidden="true"></span>
                            )}
                          </span>
                          <span class="recent-card__title" data-title-marquee>
                            <span>{review.title}</span>
                          </span>
                          <span
                            class="recent-card__stars"
                            aria-label={`${Math.round(Number(review.rating) || 0)} out of 5 stars`}
                          >
                            {starText(review.rating)}
                          </span>
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>

              {recentPages.length > 1 && (
                <>
                  <button
                    class="review-carousel__control review-carousel__control--prev"
                    type="button"
                    data-carousel-prev
                    aria-label="Show previous Recent Reviews"
                    disabled
                  >
                    <span aria-hidden="true">‹</span>
                  </button>
                  <button
                    class="review-carousel__control review-carousel__control--next"
                    type="button"
                    data-carousel-next
                    aria-label="Show next Recent Reviews"
                  >
                    <span aria-hidden="true">›</span>
                  </button>
                  <p class="visually-hidden" data-carousel-status aria-live="polite">Page 1 of {recentPages.length}</p>
                </>
              )}
            </div>

            <a class="section-view-all section-view-all--recent" href="/search" aria-label="View all recent reviews"></a>
          </section>
        )
      }

      {
        previous.length > 0 && (
          <section class="lounge-panel lounge-panel--previous" aria-labelledby="previous-heading">
            <h2 id="previous-heading" class="visually-hidden">Previously Reviewed</h2>

            <div class="previous-overlay review-carousel" data-review-carousel aria-label="Previously Reviewed carousel">
              <div class="review-carousel__viewport">
                <div class="review-carousel__track" data-carousel-track>
                  {previousPages.map((page, pageIndex) => (
                    <div
                      class="review-carousel__page"
                      data-carousel-page
                      aria-hidden={pageIndex === 0 ? 'false' : 'true'}
                      inert={pageIndex === 0 ? undefined : true}
                    >
                      {page.map((review, index) => (
                        <a
                          class={`previous-card previous-card--${index + 1}`}
                          href={reviewTarget(review.slug)}
                          aria-label={`Read ${review.title} review`}
                        >
                          {review.posterUrl ? (
                            <img
                              src={review.posterUrl}
                              alt={`${review.title} poster`}
                              loading="lazy"
                              fetchpriority="low"
                              decoding="async"
                            />
                          ) : (
                            <span class="poster-fallback" aria-hidden="true"></span>
                          )}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>

              {previousPages.length > 1 && (
                <>
                  <button
                    class="review-carousel__control review-carousel__control--prev"
                    type="button"
                    data-carousel-prev
                    aria-label="Show previous Previously Reviewed movies"
                    disabled
                  >
                    <span aria-hidden="true">‹</span>
                  </button>
                  <button
                    class="review-carousel__control review-carousel__control--next"
                    type="button"
                    data-carousel-next
                    aria-label="Show next Previously Reviewed movies"
                  >
                    <span aria-hidden="true">›</span>
                  </button>
                  <p class="visually-hidden" data-carousel-status aria-live="polite">Page 1 of {previousPages.length}</p>
                </>
              )}
            </div>

            <a class="section-view-all section-view-all--previous" href="/search" aria-label="View all previous reviews"></a>
          </section>
        )
      }

      <section id="share-your-opinion" class="lounge-panel lounge-panel--opinion" aria-labelledby="opinion-heading">
        <h2 id="opinion-heading" class="visually-hidden">Share Your Opinion</h2>

        <div class="comments-window" role="region" aria-label="Recent comments" aria-live="polite">
          <div class="comment-slot" data-comment-slot="1">
            <p class="comments-empty">No comments to show yet.</p>
          </div>
          <div class="comment-slot" data-comment-slot="2" aria-hidden="true"></div>
        </div>

        <form class="opinion-form" data-opinion-form>
          <label class="visually-hidden" for="lounge-comment-name">Your name</label>
          <input id="lounge-comment-name" name="name" maxlength="80" placeholder="Your name" autocomplete="name" />

          <label class="visually-hidden" for="lounge-comment-text">Your comment</label>
          <textarea id="lounge-comment-text" name="comment" maxlength="1500" placeholder="Your comment"></textarea>

          <button type="submit" aria-label="Submit comment"></button>
          <p class="visually-hidden" data-opinion-status aria-live="polite"></p>
        </form>
      </section>

      <section class="lounge-panel lounge-panel--banner lounge-panel--bottom" aria-label="Lounge navigation">
        <div class="lounge-banner-crop">
          <a class="lounge-nav-hit lounge-nav-hit--left" href="/" aria-label="Lounge home"></a>
          <a class="lounge-nav-hit lounge-nav-hit--right" href="/search" aria-label="Open Cini Cafe"></a>
        </div>
      </section>
    </div>
  </main>

  <script>
    import '../lib/lounge';
  </script>
</SiteFrame>
