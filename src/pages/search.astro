---
import LoungeLoading from '../components/lounge/LoungeLoading.astro';
import SiteFrame from '../layouts/SiteFrame.astro';
import { ciniCafeRuntimeAsset } from '../lib/cini-cafe-assets';
import { listCiniCafeReviews } from '../lib/data/cini-cafe';
import '../styles/cini-cafe.css';
import { createCafeFilter } from '../lib/cini-cafe-filter';
import { renderCafeCard } from '../lib/cini-cafe-card';

export const prerender = false;

Astro.response.headers.set('cache-control', 'no-store');
const catalogue = await listCiniCafeReviews();
const query = Astro.url.searchParams.get('q') ?? '';
const initialResults = createCafeFilter(catalogue)({ query, language: '', year: '', sort: 'latest' });
const initialCards = initialResults.slice(0, 6).map(renderCafeCard).join('');
const catalogueJson = JSON.stringify(catalogue)
  .replaceAll('&', '\\u0026')
  .replaceAll('<', '\\u003c')
  .replaceAll('>', '\\u003e');
---

<SiteFrame
  title="Cini Cafe — Movie Reviews By Poorna"
  description="Search and browse movie reviews in the Cini Cafe."
  preloadImages={[{ href: ciniCafeRuntimeAsset.src, fetchPriority: 'high' }]}
>
  <LoungeLoading theme="cafe" />

  <main class="cini-cafe-page" data-cinema-page aria-label="Cini Cafe review search">
    <section class="cini-cafe-stage" data-cini-cafe-stage aria-busy="false">
      <h1 class="visually-hidden">Cini Cafe</h1>

      <img
        class="cini-cafe-artwork"
        src={ciniCafeRuntimeAsset.src}
        width={ciniCafeRuntimeAsset.width}
        height={ciniCafeRuntimeAsset.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <a
        class="cini-cafe-hotspot cini-cafe-hotspot--top-lounge"
        href="/"
        aria-label="Go to The Lounge"
        title="The Lounge"
      ></a>
      <a
        class="cini-cafe-hotspot cini-cafe-hotspot--top-logo"
        href="/"
        aria-label="Movie Reviews By Poorna — go to The Lounge"
        title="Movie Reviews By Poorna"
      ></a>
      <a
        class="cini-cafe-hotspot cini-cafe-hotspot--top-cafe"
        href="/search"
        aria-label="Reload Cini Café and reset search and filters"
        title="Reload Cini Café and reset search and filters"
      ></a>

      <form class="cini-cafe-search-form" data-cini-search-form role="search" action="/search" method="get">
        <label class="visually-hidden" for="cini-cafe-search">Search reviews</label>
        <input
          id="cini-cafe-search"
          class="cini-cafe-search-input"
          data-cini-search
          name="q"
          value={query}
          type="search"
          autocomplete="off"
          placeholder="Search movies, actors, directors…"
          aria-label="Search movies, actors and directors"
        />
      </form>

      <div class="cini-cafe-filters" aria-label="Review filters">
        <label class="cini-cafe-filter cini-cafe-filter--language">
          <span class="cini-cafe-filter-label" data-cini-language-label>Language</span>
          <select data-cini-language aria-label="Filter by language"></select>
        </label>

        <label class="cini-cafe-filter cini-cafe-filter--year">
          <span class="cini-cafe-filter-label" data-cini-year-label>Year</span>
          <select data-cini-year aria-label="Filter by year"></select>
        </label>

        <label class="cini-cafe-filter cini-cafe-filter--sort">
          <span class="cini-cafe-filter-label" data-cini-sort-label>Sort By</span>
          <select data-cini-sort aria-label="Sort reviews">
            <option value="latest">Latest</option>
            <option value="oldest">Oldest</option>
            <option value="title-az">Title A–Z</option>
            <option value="title-za">Title Z–A</option>
          </select>
        </label>

        <button
          class="cini-cafe-clear"
          data-cini-clear
          type="button"
          aria-label="Clear search and filters"
          title="Clear search and filters"
        ></button>
      </div>

      <p class="cini-cafe-serving" aria-live="polite">
        <span class="cini-cafe-serving-range" data-cini-serving-range>{initialResults.length ? `1–${Math.min(6, initialResults.length)}` : '0'}</span>
        <span class="cini-cafe-serving-total" data-cini-serving-total>{initialResults.length}</span>
      </p>

      <section class="cini-cafe-results" data-cini-results aria-label="Review results" set:html={initialCards}></section>
      <nav class="cini-cafe-pagination" data-cini-pagination aria-label="Review pages"></nav>
      <p class="cini-cafe-empty" data-cini-empty hidden={initialResults.length !== 0}>No reviews match your search.</p>

      <a
        class="cini-cafe-hotspot cini-cafe-hotspot--bottom-lounge"
        href="/"
        aria-label="Go to The Lounge"
        title="The Lounge"
      ></a>
      <a
        class="cini-cafe-hotspot cini-cafe-hotspot--bottom-cafe"
        href="/search"
        aria-label="Reload Cini Café and reset search and filters"
        title="Reload Cini Café and reset search and filters"
      ></a>
    </section>
  </main>

  <script is:inline id="cini-cafe-catalogue" type="application/json" set:html={catalogueJson}></script>

  <script>
    import { initCiniCafe } from '../lib/cini-cafe';
    import { prepareCinemaPage } from '../lib/lounge-loading';

    initCiniCafe();
    const page = document.querySelector<HTMLElement>('[data-cinema-page]');
    if (page) prepareCinemaPage(page);
  </script>
</SiteFrame>
