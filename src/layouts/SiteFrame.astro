---
import '../styles/global.css';
import { loungeCriticalImages } from '../lib/lounge-assets';
import { loungeRuntimeAssets } from '../lib/lounge-assets';

interface PreloadImage {
  href: string;
  fetchPriority?: 'high' | 'low' | 'auto';
}

type StructuredData = Readonly<Record<string, unknown>> | readonly Readonly<Record<string, unknown>>[];

interface Props {
  title?: string;
  description?: string;
  preloadImages?: readonly PreloadImage[];
  canonicalPath?: string;
  socialImage?: string | null;
  socialImageAlt?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string | null;
  structuredData?: StructuredData | null;
}

const PRODUCTION_ORIGIN = 'https://moviereviewbypoorna.com';
const defaultPreloadImages: readonly PreloadImage[] = Astro.url.pathname === '/'
  ? loungeCriticalImages.map((href) => ({ href, fetchPriority: 'high' as const }))
  : [];

const {
  title = 'Movie Review By Poorna',
  description = 'Movie reviews, verdicts and cinema notes by Poorna.',
  preloadImages = defaultPreloadImages,
  canonicalPath = Astro.url.pathname,
  socialImage = loungeRuntimeAssets.topBanner,
  socialImageAlt = 'Movie Reviews By Poorna',
  ogType = 'website',
  publishedTime = null,
  structuredData = null,
} = Astro.props;

const isPreviewHost = Astro.url.hostname.endsWith('.workers.dev');
const robots = isPreviewHost
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const canonicalUrl = new URL(canonicalPath || '/', PRODUCTION_ORIGIN).toString();
const resolvedSocialImage = socialImage?.trim() || loungeRuntimeAssets.topBanner;
const socialImageUrl = new URL(resolvedSocialImage, PRODUCTION_ORIGIN).toString();
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Movie Reviews By Poorna',
  url: `${PRODUCTION_ORIGIN}/`,
  description: 'Movie reviews, verdicts and cinema notes by Poorna.',
  author: { '@type': 'Person', name: 'Poorna' },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${PRODUCTION_ORIGIN}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
} as const;
const extraStructuredData = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const structuredJson = JSON.stringify([websiteStructuredData, ...extraStructuredData]).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Poorna" />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080604" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://assets.moviereviewbypoorna.com" crossorigin />
    <link rel="dns-prefetch" href="//assets.moviereviewbypoorna.com" />

    <meta property="og:site_name" content="Movie Reviews By Poorna" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {preloadImages.map((image) => (
      <link rel="preload" as="image" href={image.href} fetchpriority={image.fetchPriority ?? 'auto'} />
    ))}
    <script type="application/ld+json" set:html={structuredJson}></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { recordCinemaPageView } from '../lib/analytics-client';
      import { initReviewDisplay } from '../lib/review-display';

      initReviewDisplay();
      recordCinemaPageView();
    </script>
  </body>
</html>
