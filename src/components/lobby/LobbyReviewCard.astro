---
import type { ReviewSummary } from '../../domain/review';

interface Props {
  review: ReviewSummary;
  priority?: boolean;
}

const { review, priority = false } = Astro.props;
---

<article class="review-card">
  <div class="review-card__poster">
    {
      review.posterUrl ? (
        <img
          src={review.posterUrl}
          alt={`${review.title} poster`}
          width="600"
          height="900"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
        />
      ) : (
        <div class="review-card__poster-fallback" aria-hidden="true"></div>
      )
    }
  </div>

  <div class="review-card__copy">
    <p class="review-card__meta">
      {review.language ?? 'Language not listed'}
      <span aria-hidden="true">·</span>
      {review.reviewedDate}
    </p>
    <h3>{review.title}</h3>
    {review.verdict && <p class="review-card__verdict">{review.verdict}</p>}
  </div>
</article>

<style>
  .review-card {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .review-card__poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    box-shadow: var(--shadow-soft);
  }

  .review-card__poster img,
  .review-card__poster-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-card__copy {
    min-width: 0;
  }

  .review-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .review-card h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    line-height: 1.15;
  }

  .review-card__verdict {
    display: -webkit-box;
    margin-bottom: 0;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
