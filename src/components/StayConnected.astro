---
const socialLinks = {
  instagram: 'https://www.instagram.com/moviereviewbypoorna/',
  facebook: 'https://www.facebook.com/moviereviewbypoorna',
  x: 'https://x.com/reviewbypoorna',
  whatsapp: 'https://whatsapp.com/channel/0029VaKoQMp2UPBPOlNDg546',
} as const;
---

<section class="stay-connected" data-stay-connected aria-labelledby="stay-connected-title">
  <div class="stay-connected__copy">
    <h2 id="stay-connected-title">STAY CONNECTED</h2>
    <p>New reviews, My POVs &amp; movie conversations.</p>
  </div>

  <nav class="stay-connected__links" aria-label="Follow Movie Review By Poorna">
    <a
      class="stay-connected__link"
      href={socialLinks.instagram}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Follow Movie Review By Poorna on Instagram"
      title="Instagram"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle class="stay-connected__dot" cx="17.4" cy="6.7" r="1.1"></circle>
      </svg>
      <span>Instagram</span>
    </a>

    <a
      class="stay-connected__link"
      href={socialLinks.facebook}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Follow Movie Review By Poorna on Facebook"
      title="Facebook"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.2 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.6 1.6-1.6h1.7V3.8c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2H8v3h2.8v8h3.4Z"></path>
      </svg>
      <span>Facebook</span>
    </a>

    <a
      class="stay-connected__link"
      href={socialLinks.x}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Follow Movie Review By Poorna on X"
      title="X"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 4l14 16M19 4 5 20"></path>
      </svg>
      <span>X</span>
    </a>

    <a
      class="stay-connected__link"
      href={socialLinks.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Follow the Movie Review By Poorna WhatsApp Channel"
      title="WhatsApp Channel"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4.1A8 8 0 1 1 20 11.7Z"></path>
        <path d="M9 8.3c.3 2.8 2 4.5 4.8 5.4"></path>
        <path d="M8.8 8.1 10 7.6l1 2-1 .8M13.8 13.7l.8-1 2 1-.4 1.2"></path>
      </svg>
      <span>WhatsApp<span class="stay-connected__channel"> Channel</span></span>
    </a>
  </nav>
</section>

<script>
  const stayConnected = document.querySelector<HTMLElement>('[data-stay-connected]');
  const bottomNavigation = document.querySelector<HTMLElement>(
    '.lounge-panel--bottom, .auditorium-section--bottom',
  );

  if (stayConnected && bottomNavigation?.parentElement) {
    bottomNavigation.parentElement.insertBefore(stayConnected, bottomNavigation);
  }
</script>

<style>
  .stay-connected {
    position: relative;
    z-index: 4;
    width: min(100%, 1086px);
    margin: clamp(14px, 2.4vw, 24px) auto;
    padding: clamp(14px, 2.4vw, 24px);
    box-sizing: border-box;
    border: 1px solid rgb(241 241 241 / 16%);
    border-top-color: rgb(247 1 14 / 58%);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgb(247 1 14 / 5%), transparent 42%),
      rgb(6 5 5 / 94%);
    box-shadow:
      0 16px 34px rgb(0 0 0 / 38%),
      inset 0 1px 0 rgb(241 241 241 / 5%);
    color: #f1f1f1;
    font-family: Inter, "Segoe UI", Arial, sans-serif;
  }

  .stay-connected__copy {
    margin-bottom: clamp(12px, 1.8vw, 18px);
    text-align: center;
  }

  .stay-connected__copy h2 {
    margin: 0;
    color: #f1f1f1;
    font-size: clamp(16px, 2.4vw, 24px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.12em;
  }

  .stay-connected__copy h2::after {
    content: "";
    display: block;
    width: 72px;
    height: 2px;
    margin: 9px auto 0;
    border-radius: 999px;
    background: #f7010e;
    box-shadow: 0 0 12px rgb(247 1 14 / 36%);
  }

  .stay-connected__copy p {
    margin: 9px 0 0;
    color: rgb(241 241 241 / 72%);
    font-size: clamp(12px, 1.7vw, 15px);
    line-height: 1.35;
  }

  .stay-connected__links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(7px, 1.4vw, 14px);
  }

  .stay-connected__link {
    min-width: 0;
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(6px, 1vw, 10px);
    padding: 9px 8px;
    box-sizing: border-box;
    border: 1px solid rgb(241 241 241 / 16%);
    border-radius: 12px;
    background: rgb(255 255 255 / 3%);
    color: #f1f1f1;
    text-decoration: none;
    font-size: clamp(10px, 1.45vw, 14px);
    font-weight: 700;
    line-height: 1.05;
    text-align: center;
    transition: border-color 140ms ease, background 140ms ease, box-shadow 140ms ease, transform 140ms ease;
  }

  .stay-connected__link svg {
    flex: 0 0 auto;
    width: clamp(20px, 2.5vw, 26px);
    height: clamp(20px, 2.5vw, 26px);
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stay-connected__link:nth-child(2) svg path {
    fill: currentColor;
    stroke: none;
  }

  .stay-connected__dot {
    fill: currentColor;
    stroke: none;
  }

  .stay-connected__link:hover,
  .stay-connected__link:focus-visible {
    border-color: rgb(247 1 14 / 72%);
    background: rgb(247 1 14 / 8%);
    box-shadow: 0 0 18px rgb(247 1 14 / 14%);
  }

  .stay-connected__link:active {
    transform: translateY(1px);
  }

  .stay-connected__link:focus-visible {
    outline: 2px solid rgb(241 241 241 / 70%);
    outline-offset: 2px;
  }

  @media (max-width: 600px) {
    .stay-connected {
      width: calc(100% - 18px);
      margin-block: 12px;
      padding: 13px 10px;
      border-radius: 14px;
    }

    .stay-connected__copy {
      margin-bottom: 10px;
    }

    .stay-connected__links {
      gap: 6px;
    }

    .stay-connected__link {
      min-height: 54px;
      flex-direction: column;
      gap: 4px;
      padding: 7px 3px;
      border-radius: 10px;
      font-size: 10px;
    }

    .stay-connected__link svg {
      width: 22px;
      height: 22px;
    }

    .stay-connected__channel {
      display: none;
    }
  }
</style>
