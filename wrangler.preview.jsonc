{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movie-review-by-poorna-preview",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "movie-review-by-poorna-content",
      "database_id": "6c88b16c-c302-47cf-92cd-bdc5f8470bc2",
      "migrations_dir": "migrations"
    }
  ],
  "main": "./src/worker.ts",
  "r2_buckets": [
    {
      "binding": "REVIEW_ASSETS",
      "bucket_name": "movie-review-assets"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "2026091202",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LEGACY_REACTIONS",
        "class_name": "ReactionStore",
        "script_name": "movie-review-by-poorna"
      }
    ]
  }
}
