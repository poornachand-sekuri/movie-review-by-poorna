{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movie-review-by-poorna-home-preview",
  "main": "src/preview-worker.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
